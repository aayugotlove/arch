{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "logout",
    "action" : "command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "sleep",
    "action" : "loginctl lock-session && systemctl suspend",
    "text" : "Sleep",
    "keybind" : "h"
}
{
    "label" : "lock",
    "action" : "hyprlock -c ~/.config/hypr/hyprlock/hyprlock.conf",
    "text" : "Lock",
    "keybind" : "l"
}
